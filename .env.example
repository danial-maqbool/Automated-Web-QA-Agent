# WebQA Agent Configuration

# Server settings
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///data/webqa.db
DATA_DIRECTORY=data

# Playwright Browser Engine
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
DEFAULT_MAX_PAGES=50
DEFAULT_MAX_DEPTH=3
DEFAULT_WORKERS=3
REQUEST_TIMEOUT_MS=30000

# Optional AI Analysis (Core deterministic engine runs without AI)
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CI / Quality Gate Defaults
CI_FAIL_ON_CRITICAL=true
CI_MAX_HIGH_ISSUES=3
CI_MIN_QA_SCORE=80
